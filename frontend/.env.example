# Copy to .env.local to override. Never commit real values (Section 14).
# `npm run dev` uses .env.development (local backend); `npm run dev:mock` uses .env.mock (MSW, no backend).
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Identity provider. Locally this is the backend's dev IdP; in real environments the OIDC authority. [CONFIRM]
VITE_OIDC_AUTHORITY=http://localhost:3000/dev-idp
VITE_OIDC_CLIENT_ID=
VITE_SENTRY_DSN=
VITE_ENABLE_MOCKS=false
# Days before warranty end that count as "expiring soon" (Section 5.3). Keep in sync with the API.
VITE_EXPIRING_SOON_DAYS=60

# Must match the API's REQUIRE_PROOF_OF_PURCHASE. [CONFIRM]
VITE_REQUIRE_PROOF_OF_PURCHASE=true
