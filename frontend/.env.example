# Copy to .env.local and fill in. Never commit real values (Section 14).
VITE_API_BASE_URL=http://localhost:8080/api
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_SENTRY_DSN=
# "true" runs the app against MSW mocks instead of a real API (`npm run dev:mock` sets this).
VITE_ENABLE_MOCKS=false
# Days before warranty end that count as "expiring soon" (Section 5.3).
VITE_EXPIRING_SOON_DAYS=60
