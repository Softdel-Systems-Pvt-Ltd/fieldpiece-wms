# Conventional Commits, e.g. "feat(claims): add reject modal" (Section 14).
# Existing ticket-style prefixes (e.g. "WMS-001: ...") are also accepted.
msg=$(head -n1 "$1")
if ! echo "$msg" | grep -Eq '^((feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?|[A-Z]+-[0-9]+): .+'; then
  echo "Commit message must follow Conventional Commits, e.g. feat(claims): add reject modal"
  exit 1
fi
